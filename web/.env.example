# Base path the SPA calls. Left relative in development so requests go through
# the Vite proxy below; set to the API's absolute URL in a production build.
VITE_API_URL=/api/v1

# Where the dev proxy forwards /api. Use an explicit IP rather than "localhost":
# the PHP dev server listens on IPv4 only.
VITE_PROXY_TARGET=http://127.0.0.1:8000
